{ ... }:

{
# Pre-commit hook для проверки Nix-кода (запускается перед каждым коммитом)
# Проверяет форматирование, статику и наличие мёртвого кода
  home.file.".git/hooks/pre-commit" = {
    executable = true;
    text = ''
      #!/usr/bin/env bash
      # Pre-commit hook для проверки Nix-кода
      echo "Running pre-commit checks..."

      # Проверка форматирования
      if ! alejandra --check .; then
        echo "❌ Форматирование не соответствует стилю."
        echo "Запустите 'alejandra .' и закоммитьте изменения."
        exit 1
      fi

      # Статический анализ
      if ! statix check .; then
        echo "❌ Статический анализ не пройден. Исправьте ошибки."
        exit 1
      fi

      # Поиск мёртвого кода (опционально, можно отключить)
      if ! deadnix .; then
        echo "⚠️  Найден потенциально неиспользуемый код."
        echo "Запустите 'deadnix -e' для автоматического удаления."
        # exit 1  # Можно не блокировать коммит, только предупреждать
      fi

      echo "✅ Все проверки пройдены."
    '';
  };
}
