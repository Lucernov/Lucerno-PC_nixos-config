# Секреты и хэши паролей
/secrets/
*.hash
*.key

# Результаты сборок Nix
/result
/result-*

# Временные файлы редакторов
*~
*.swp
*.tmp
*.bak

# Папка корзины (если пользуетесь GUI)
.Trash-*
**/.Trash-*

# Логи
*.log

# Большие папки Steam (не должны быть в Git)
/dotfiles/config/Steam/userdata/

# Игнорировать всё в dotfiles, кроме wallpapers и разрешённых папок config
/dotfiles/*
!/dotfiles/wallpapers/
!/dotfiles/wallpapers/**/*
!/dotfiles/config/
/dotfiles/config/*
!/dotfiles/config/zsh/
!/dotfiles/config/zsh/*
!/dotfiles/config/yabridgectl/
!/dotfiles/config/yabridgectl/*

