# =============================================================================
# Секреты (secrets/)
# =============================================================================
# Логика:
#   1. Блокируем ВСЁ в secrets/ — на случай, если что-то забудем.
#   2. Разблокируем только то, что безопасно хранить в git:
#      - зашифрованные .age-файлы (ключ локальный, в git его нет)
#      - карта секретов secrets.nix (не секрет, только публичные ключи)
#      - rclone/exclude.txt и rclone/обновление*.txt (не секреты)
#   3. Открытые секреты (без .age) остаются заблокированными.

# Блокируем всё содержимое secrets/ — файлы и подпапки
/secrets/*

# Разблокируем зашифрованные файлы и карту секретов
!/secrets/*.age
!/secrets/secrets.nix

# rclone: разблокируем папку, чтобы git мог заглянуть внутрь
!/secrets/rclone/
# ...но блокируем всё её содержимое
/secrets/rclone/*
# ...кроме этих двух не-секретных файлов
!/secrets/rclone/exclude.txt
!/secrets/rclone/обновление токена гуглдрайва.txt

# Двойная страховка: любые *.hash и *.key — игнорировать, где бы они ни лежали.
# Это блокирует secrets/lucerno-password.hash (открытый хеш).
# НЕ блокирует lucerno-password.hash.age — у него суффикс .age, а не .hash.
*.hash
*.key

# =============================================================================
# Nix
# =============================================================================
# Симлинки результатов сборки (nix build / nixos-rebuild build)
/result
/result-*

# =============================================================================
# Редакторы
# =============================================================================
*~
*.swp
*.kate-swp
*.tmp
*.bak

# =============================================================================
# Мусор файловой системы
# =============================================================================
.Trash-*
**/.Trash-*

# =============================================================================
# Логи
# =============================================================================
*.log

# =============================================================================
# dotfiles/
# =============================================================================
# Логика: блокируем всё, разблокируем только нужные папки.
# Если добавляете новую папку конфига — добавьте !-правило для неё и её
# содержимого (иначе файлы внутри останутся заблокированными).
/dotfiles/*
!/dotfiles/wallpapers/
!/dotfiles/wallpapers/**/*
!/dotfiles/config/
/dotfiles/config/*
!/dotfiles/config/zsh/
!/dotfiles/config/zsh/*
!/dotfiles/config/yabridgectl/
!/dotfiles/config/yabridgectl/*
!/dotfiles/repo/
!/dotfiles/repo/**/*
!/dotfiles/sys-icons/
!/dotfiles/sys-icons/**/*
