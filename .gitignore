# =============================================================================
# Секреты (secrets/)
# =============================================================================
# Логика: блокируем ВСЁ, разблокируем только безопасное для git:
#   - зашифрованные .age-файлы (ключ локальный, в git его нет)
#   - карта секретов secrets.nix (не секрет, только публичные ключи)
#   - открытые секреты (без .age) остаются заблокированными
/secrets/*
!/secrets/*.age
!/secrets/secrets.nix

# =============================================================================
# Nix
# =============================================================================
# Симлинки результатов сборки (nix build / nixos-rebuild build)
/result
/result-*

# =============================================================================
# Редакторы
# =============================================================================
*~
*.swp
*.kate-swp
*.tmp
*.bak

# =============================================================================
# Мусор файловой системы
# =============================================================================
.Trash-*
**/.Trash-*

# =============================================================================
# Логи
# =============================================================================
*.log

# =============================================================================
# dotfiles/
# =============================================================================
# Логика: блокируем всё, разблокируем только нужные папки.
# Если добавляете новую папку конфига — добавьте !-правило для неё и её
# содержимого (иначе файлы внутри останутся заблокированными).
/dotfiles/*
!/dotfiles/wallpapers/
!/dotfiles/wallpapers/**/*
!/dotfiles/config/
/dotfiles/config/*
!/dotfiles/config/zsh/
!/dotfiles/config/zsh/*
!/dotfiles/config/yabridgectl/
!/dotfiles/config/yabridgectl/*
!/dotfiles/repo/
!/dotfiles/repo/**/*
!/dotfiles/sys-icons/
!/dotfiles/sys-icons/**/*
!/dotfiles/scripts/
/dotfiles/scripts/*
!/dotfiles/scripts/*.sh

# =============================================================================
# Ключи и хеши
# =============================================================================
# Любые *.hash и *.key — игнорировать, где бы они ни лежали
*.hash
*.key
